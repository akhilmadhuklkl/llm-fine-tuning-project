{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident Triage Example",
  "type": "object",
  "required": ["id", "category", "messages", "expected_output"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "expected_output": {
      "type": "object",
      "required": ["severity", "incident_type", "observed_facts", "hypotheses", "next_steps", "escalation_required"],
      "properties": {
        "severity": {"enum": ["SEV-0", "SEV-1", "SEV-2", "SEV-3", "none", "unknown"]},
        "incident_type": {"type": "string"},
        "affected_services": {"type": "array", "items": {"type": "string"}},
        "observed_facts": {"type": "array", "items": {"type": "string"}},
        "hypotheses": {"type": "array", "items": {"type": "string"}},
        "next_steps": {"type": "array", "items": {"type": "string"}},
        "escalation_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
